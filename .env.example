# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Profile ─────────────────────────────────────────────────────────────────
# Directory containing your personal profile files (voice, goals, projects).
# Leave blank to use the generic fallback: "profile/" in the project root.
OBSIDIAN_PROFILE_DIR=

# Draft output directory for react_worker / finish_worker.
# Leave blank to use "vault/10_Drafts" in the project root.
DRAFT_OUTPUT_DIR=

# Legacy alias for DRAFT_OUTPUT_DIR (kept for backward compatibility).
VAULT_DRAFTS_PATH=vault/10_Drafts

# Comma-separated critical profile filenames (loaded verbatim into curator prompt).
PROFILE_CRITICAL_FILES=fact_dossier.md,voice_profile.md,writing_guide.md

# Comma-separated advisory profile filenames (loaded when space allows).
PROFILE_ADVISORY_FILES=goals.md,content_persona.md,project-graph.md

# ── Curation ─────────────────────────────────────────────────────────────────
# LLM backend for curator scoring: "ollama" (default) | "claude" | "claude-batch"
# Warning: CURATOR_BACKEND=claude is slow for large batches (one subprocess per post).
CURATOR_BACKEND=ollama

# Score floor for "curated" status (0-100). Posts below this threshold are rejected.
CURATOR_THRESHOLD=75

# Ollama model used for curation (and editor when EDITOR_BACKEND_{CAT}=ollama).
CURATOR_MODEL=qwen2.5:7b

# Ollama host (change if Ollama runs on a different machine or port).
OLLAMA_HOST=http://localhost:11434

# Vision model for OCR fallback on short-caption posts (optional).
# Leave unset to disable. Example: moondream (fast, ~1.7 GB) or llava (~4.7 GB).
VISION_MODEL=

# ── Editor ───────────────────────────────────────────────────────────────────
# Per-category editor backend override.
# Supported values: "ollama" | "claude" | "claude-batch"
# Uncomment and set to override the default routing (curator_routing.yaml).
# EDITOR_BACKEND_AI=ollama
# EDITOR_BACKEND_CRYPTO=ollama
# EDITOR_BACKEND_STARTUP=ollama
# EDITOR_BACKEND_PSYCHOLOGY=ollama
# EDITOR_BACKEND_SCIENCE=ollama
# EDITOR_BACKEND_RESEARCH=ollama
# EDITOR_BACKEND_FITNESS=ollama
# EDITOR_BACKEND_FINTECH=ollama
# EDITOR_BACKEND_NEWSLETTER=ollama
# EDITOR_BACKEND_OTHER=ollama

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite database file path. Tests monkeypatch this to an isolated tmp file.
DB_PATH=curator.db

# ── Telegram (optional — only required for live collection) ──────────────────
# Obtain credentials at https://my.telegram.org/apps
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Telegram session file path (no extension needed — telethon appends .session).
TG_SESSION_PATH=telegram_session

# ── Email / IMAP (optional — only required for newsletter collection) ─────────
# Gmail: use an App Password (https://myaccount.google.com/apppasswords).
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=your_email_here@gmail.com
EMAIL_PASS=your_16_char_app_password_here
EMAIL_FOLDER=INBOX

# ── Instagram (optional) ─────────────────────────────────────────────────────
# Use a dedicated secondary account. Leave EMAIL_USER and INSTAGRAM_USER unset
# to disable the respective collector.
INSTAGRAM_USER=
INSTAGRAM_PASS=
# Set to any non-empty value AFTER the IG account is warmed up (3-7 days mobile use).
INSTAGRAM_WARMUP_CONFIRMED=

# ── ChromaDB cluster pre-filter (optional advanced) ──────────────────────────
# When on, curator groups posts into embedding-similarity clusters and scores
# one representative per cluster, propagating the verdict to all members.
# Default off — validate on your embedding distribution before enabling.
# CHROMA_CLUSTER_PREFILTER=off
# CHROMA_CLUSTER_MAX_SIZE=10
CLUSTER_MEMBER_COSINE_FLOOR=0.7
